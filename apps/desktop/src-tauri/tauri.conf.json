{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motionwright",
  "version": "0.1.0",
  "identifier": "com.seradotcom.motionwright",
  "build": {
    "beforeDevCommand": "npm --prefix ../studio run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../studio run build",
    "frontendDist": "../../studio/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Motionwright",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "desktop-owner"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "deb",
      "appimage"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/uninstall-ownership.nsh"
      }
    },
    "icon": [
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Semwright-native creative production studio",
    "longDescription": "Motionwright is a local-first creative production studio for semantic audiovisual projects.",
    "resources": {
      "bundle-licenses/LICENSE": "licenses/motionwright/LICENSE",
      "bundle-licenses/THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "bundle-licenses/glib-0.18.5/LICENSE": "licenses/glib-0.18.5/LICENSE",
      "bundle-licenses/glib-0.18.5/COPYRIGHT": "licenses/glib-0.18.5/COPYRIGHT"
    }
  }
}
